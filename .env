# What to measure: host:port, comma separated.
# Add your own server or website, e.g. 1.1.1.1:443,8.8.8.8:443,yourcompany.com:443
TARGETS=https://www.google.com,8.8.8.8:443

# Your timezone. The daily report covers one calendar day in this timezone and is sent just after midnight.
TZ=Asia/Jakarta

# How it decides something is abnormal
INTERVAL_SEC=5
THRESHOLD_MS=150
SPIKE_FACTOR=3
CONSECUTIVE=3
COOLDOWN_MIN=30

# Email (Gmail: use an app password, host smtp.gmail.com, port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=you@gmail.com
MAIL_TO=you@gmail.com

# Daily PDF report by email: on or off
DAILY_REPORT=on
# Days of history and logs to keep
RETENTION_DAYS=30

# Optional: password for the dashboard (any username)
DASH_PASSWORD=
